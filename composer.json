{
    "name": "laravel/zero-text-assertion-repro",
    "description": "Minimal reproduction for assertSeeText('0') across Laravel 12 and 13",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --filter test_missing_zero_must_fail_text_assertion"
    },
    "config": {
        "sort-packages": true
    }
}
